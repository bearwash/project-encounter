# Project Encounter — フロントエンド環境変数 (Next.js)
# このファイルをコピーして `.env.local` を作成し、値を埋めてください。
# spec: docs/specs/profile-sync.md §5.1, §5.2

# Supabase project の URL と anon key
# 例: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 値が未設定なら mock モード (Rust 側の profile_fetch_remote にフォールバック)。
# 値があれば Supabase 経由でプロフィールを upsert / fetch する。
