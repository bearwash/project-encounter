# Project Encounter — フロントエンド環境変数 (Next.js)
# このファイルをコピーして `.env.local` を作成し、値を埋めてください。
# spec: docs/specs/profile-sync.md §5.1, §5.2

# Supabase project の URL と anon key
# 例: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 開発・審査検証ビルドだけで有効化する。一般公開ビルドでは 0 のままにする。
NEXT_PUBLIC_ENABLE_TEST_LOGIN=0
NEXT_PUBLIC_ENABLE_TEST_PURCHASES=0

# StoreKit / Play Billing のレシート検証 API。未設定時は本番購入を成功扱いにしない。
NEXT_PUBLIC_PURCHASE_API_URL=

# 公開ページ / ストア申請。提出ビルドでは必ず実値を設定する。
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PUBLIC_SITE_URL=

# 省略時は <NEXT_PUBLIC_SUPABASE_URL>/functions/v1/delete-account を使う。
NEXT_PUBLIC_ACCOUNT_DELETE_URL=

# 値が未設定なら mock モード (Rust 側の profile_fetch_remote にフォールバック)。
# 値があれば Supabase 経由でプロフィールを upsert / fetch する。
#
# Supabase Studio で必要な設定:
# - Authentication > Providers > Anonymous Sign-ins を有効化
# - docs/contracts/supabase-schema.sql を SQL Editor で実行
#
# 実プロジェクトの疎通確認:
# NEXT_PUBLIC_SUPABASE_URL=... NEXT_PUBLIC_SUPABASE_ANON_KEY=... pnpm server:smoke
