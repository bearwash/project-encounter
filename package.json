{
  "name": "project-encounter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 1420",
    "build": "next build",
    "ios:sync-assets": "node scripts/sync-ios-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "server:check": "node scripts/supabase-contract-check.mjs",
    "server:test": "node --test tests/server/*.test.mjs",
    "server:preflight": "pnpm server:check && pnpm server:test && pnpm typecheck && pnpm lint",
    "server:smoke": "node scripts/supabase-smoke.mjs",
    "ble:check-artifacts": "node scripts/ble-artifact-check.mjs",
    "ble:preflight": "pnpm lint && pnpm typecheck && pnpm server:check && pnpm ble:check-artifacts",
    "ble:android:install": "/opt/homebrew/share/android-commandlinetools/platform-tools/adb install -r \"src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk\"",
    "ble:android:logcat": "/opt/homebrew/share/android-commandlinetools/platform-tools/adb logcat -s EncounterBle chromium project_encounter",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "framer-motion": "^12.38.0",
    "next": "^15.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
